# Embed the bundled JavaScript of pyjs into a C++ source of libpyjs:
#
#   cmake -DIN=<bundle.js> -DOUT=<pyjs_js.cpp> -P embed_js.cmake
#
# emscripten carries the code of an EM_JS function inside the object file and
# emits it into the generated runtime at link time; what follows the function
# body lands at the top level of the runtime. So linking libpyjs is all an
# embedder needs: no --pre-js / --post-js files. The code is passed as raw
# string literal (verbatim: no preprocessor in the way) to _EM_JS, the macro
# behind EM_JS, which takes the code as string.
file(READ "${IN}" JS)
file(WRITE "${OUT}" "// generated by build_utils/embed_js.cmake from src/js/: do not edit
#include <emscripten/em_js.h>

// pyjs_js_prelude(): initializes the JavaScript side. The code after its body
// lands at the top level of the runtime: it declares `pyjsCore` (the
// JavaScript counterpart of the Python module pyjs_core, filled by
// src/js/index.ts) and contains the bundled code that fills it.
_EM_JS(void, pyjs_js_prelude, pyjs_js_prelude, (), R\"PYJS_JS({ pyjsCore.init(); }
var pyjsCore;
${JS}
)PYJS_JS\")
")
