# pyjs cmake module: `find_package(pyjs)` defines
#
#   pyjs_FOUND - true if pyjs was found
#   pyjs       - the target of the static library. Linking it is all an
#                emscripten main module needs: the JavaScript part of pyjs is
#                inside the library (no --pre-js / --post-js files).
@PACKAGE_INIT@

if(NOT TARGET pyjs)
    include("${CMAKE_CURRENT_LIST_DIR}/pyjsTargets.cmake")
endif()
